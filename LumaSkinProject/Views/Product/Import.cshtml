@{
    ViewData["Title"] = "นำเข้าข้อมูลสินค้า - Luma Skin";
    Layout = "_Layout";
}

<div class="container py-5" style="max-width: 800px;">
    <!-- หัวข้อหน้า -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="color: #5c3d63;">นำเข้าสินค้าจากไฟล์ CSV</h2>
            <p class="text-muted small">อัปโหลดไฟล์ข้อมูลสินค้าเพื่ออัปเดตเข้าระบบหลังบ้าน Luma Skin</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> กลับหน้าแดชบอร์ด
        </a>
    </div>

    <!-- แจ้งเตือนเมื่อนำเข้าสำเร็จ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- แสดงรายการ Error แถวที่ข้อมูลไม่ถูกต้องตามโจทย์ -->
    @if (ViewBag.Errors != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm p-4 mb-4" role="alert">
            <h5 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>พบข้อผิดพลาดในไฟล์ CSV กรุณาแก้ไขก่อนลองใหม่อีกครั้ง:</h5>
            <ul class="mb-0 ps-3">
                @foreach (var error in ViewBag.Errors)
                {
                    <li class="py-1 text-dark small">@error</li>
                }
            </ul>
        </div>
    }

    <!-- ฟอร์มสำหรับอัปโหลดไฟล์ -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <form asp-controller="Product" asp-action="ImportCsv" method="post" enctype="multipart/form-data">
            <div class="mb-4">
                <label for="csvFile" class="form-label fw-semibold text-secondary">เลือกไฟล์ CSV สินค้า</label>
                <input type="file" class="form-control form-control-lg rounded-3" id="csvFile" name="csvFile" accept=".csv" required />
                <div class="form-text mt-2 text-muted">
                    * รูปแบบหัวคอลัมน์ใน CSV ต้องประกอบด้วย: <code class="text-purple">sku, name, category, price, size, description, how_to_use, status</code>
                </div>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn py-3 fw-bold text-white rounded-3 shadow-sm" style="background-color: #5c3d63; transition: all 0.2s;">
                    <i class="bi bi-cloud-arrow-up me-2"></i> อัปโหลดและตรวจสอบข้อมูล
                </button>
            </div>
        </form>
    </div>
</div>