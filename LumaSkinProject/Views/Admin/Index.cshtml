@{
    ViewData["Title"] = "Luma Skin - Admin Dashboard";
    Layout = "_Layout"; // หรือปรับเป็น Layout เปล่าตามต้องการ
}

<!-- Custom Style สำหรับโทนสีม่วงแบรนด์ Luma Skin -->
<style>
    :root {
        --luma-purple: #5c3d63;
        --luma-light-purple: #f3eff5;
        --luma-lavender: #dcd6f7;
    }
    
    body {
        background-color: #f8f9fa;
    }

    .sidebar {
        background-color: #ffffff;
        border-right: 1px solid #eaeaea;
        min-height: 85vh;
    }

    .nav-link {
        color: #6c757d;
        font-weight: 500;
        border-radius: 8px;
        margin-bottom: 4px;
        transition: all 0.2s;
    }

    .nav-link:hover, .nav-link.active {
        background-color: var(--luma-light-purple);
        color: var(--luma-purple);
    }

    .btn-luma {
        background-color: var(--luma-purple);
        color: #ffffff;
        border-radius: 8px;
    }

    .btn-luma:hover {
        background-color: #4a304f;
        color: #ffffff;
    }

    .card-stat {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(92, 61, 99, 0.05);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar ด้านข้าง -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
            <div class="text-center py-3 mb-3 border-bottom">
                <h5 class="fw-bold m-0" style="color: var(--luma-purple); letter-spacing: 1px;">LUMA SKIN</h5>
                <small class="text-muted">Admin Panel</small>
            </div>
            
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active py-2 px-3" href="#"><i class="bi bi-grid me-2"></i> ภาพรวมระบบ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-2 px-3" href="#"><i class="bi bi-box-seam me-2"></i> จัดการสินค้า</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-2 px-3" href="#"><i class="bi bi-file-earmark-arrow-up me-2"></i> นำเข้าไฟล์ CSV</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-2 px-3" href="#"><i class="bi bi-qr-code me-2"></i> สร้าง & ปรับแต่ง QR</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-2 px-3" href="#"><i class="bi bi-bar-chart me-2"></i> บันทึกการสแกน</a>
                </li>
                <li class="nav-item mt-4">
                    <a class="nav-link py-2 px-3 text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i> ออกจากระบบ</a>
                </li>
            </ul>
        </nav>

        <!-- Main Content ส่วนเนื้อหาหลัก -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            
            <!-- Header หัวข้อหน้า -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-dark mb-1">ภาพรวมระบบ (Dashboard)</h2>
                    <p class="text-muted small mb-0">ยินดีต้อนรับกลับมา, ผู้ดูแลระบบ Luma Skin</p>
                </div>
                <div>
                    <button class="btn btn-luma px-3 py-2"><i class="bi bi-plus-lg me-1"></i> เพิ่มสินค้าใหม่</button>
                </div>
            </div>

            <!-- Card สถิติย่อ -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card card-stat p-3 bg-white">
                        <span class="text-muted small">สินค้าทั้งหมดในระบบ</span>
                        <h3 class="fw-bold mt-1" style="color: var(--luma-purple);">24 รายการ</h3>
                        <span class="text-success small"><i class="bi bi-arrow-up"></i> อัปเดตล่าสุดวันนี้</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card card-stat p-3 bg-white">
                        <span class="text-muted small">ยอดการสแกน QR ทั้งหมด</span>
                        <h3 class="fw-bold mt-1" style="color: var(--luma-purple);">1,428 ครั้ง</h3>
                        <span class="text-success small"><i class="bi bi-graph-up-arrow"></i> +12% จากสัปดาห์ก่อน</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card card-stat p-3 bg-white">
                        <span class="text-muted small">สินค้ายอดฮิตสูงสุด</span>
                        <h6 class="fw-bold mt-2 text-dark text-truncate">Glow & Bright Serum (LS-0001)</h6>
                        <span class="text-muted small">ถูกสแกน 420 ครั้ง</span>
                    </div>
                </div>
            </div>

            <!-- ตารางแสดงรายการสินค้าตัวอย่าง (Mock Data) -->
            <div class="card card-stat bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0">รายการสินค้าล่าสุด</h5>
                    <a href="#" class="small text-decoration-none" style="color: var(--luma-purple);">ดูทั้งหมด</a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">SKU</th>
                                <th class="py-3">ชื่อสินค้า</th>
                                <th class="py-3">หมวดหมู่</th>
                                <th class="py-3">ราคา</th>
                                <th class="py-3">สถานะ</th>
                                <th class="py-3 text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-secondary">LS-0001</td>
                                <td>
                                    <div class="fw-bold text-dark">Glow & Bright Serum</div>
                                    <small class="text-muted">30 ml</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">Serum</span></td>
                                <td>฿890.00</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Active</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-qr-code"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-secondary">LS-0002</td>
                                <td>
                                    <div class="fw-bold text-dark">Gentle Hydrating Cleanser</div>
                                    <small class="text-muted">150 ml</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">Cleanser</span></td>
                                <td>฿550.00</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Active</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-qr-code"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-secondary">LS-0003</td>
                                <td>
                                    <div class="fw-bold text-dark">Daily Soothing Toner</div>
                                    <small class="text-muted">200 ml</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">Toner</span></td>
                                <td>฿620.00</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">Inactive</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-qr-code"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>