@{
    ViewData["Title"] = "Admin Login - Luma Skin";
    Layout = "null";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <!-- หัวข้อแบรนด์ -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark">Luma Skin</h2>
                        <p class="text-muted">ระบบจัดการหลังบ้านสำหรับผู้ดูแลระบบ</p>
                    </div>

                    <!-- แสดงข้อความแจ้งเตือน Error หาก Login ไม่ผ่าน -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="All" class="mb-0 text-danger small"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- ฟอร์มเข้าสู่ระบบ -->
                    <form asp-controller="Admin" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">อีเมล (Email)</label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="admin@lumaskin.com" required />
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">รหัสผ่าน (Password)</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark py-2 fw-bold">เข้าสู่ระบบ</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- หมายเหตุตามโจทย์: ไม่มีหน้าสมัครสมาชิก -->
            <div class="text-center mt-3">
                <small class="text-muted">ระบบนี้เฉพาะเจ้าหน้าที่ภายในเท่านั้น ไม่มีบริการสมัครสมาชิกภายนอก</small>
            </div>
        </div>
    </div>
</div>