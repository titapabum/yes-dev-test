@{
    ViewData["Title"] = "Admin Login - Luma Skin";
    Layout = "_Layout"; 
}

<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --luma-purple: #5c3d63;
        --luma-light-purple: #f5f0f7;
    }

    body {
        font-family: 'Prompt', sans-serif !important;
        background-color: #f8f9fa;
    }

    .card-login {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 25px rgba(92, 61, 99, 0.08);
    }

    .btn-luma {
        background-color: var(--luma-purple);
        color: #ffffff;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-luma:hover {
        background-color: #4a304f;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(92, 61, 99, 0.2);
    }

    .form-control:focus {
        border-color: var(--luma-purple);
        box-shadow: 0 0 0 0.25rem rgba(92, 61, 99, 0.15);
    }
</style>

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card card-login p-4 bg-white">
                <div class="text-center mb-4 pt-2">
                    <h3 class="fw-bold m-0" style="color: var(--luma-purple); letter-spacing: 1.5px;">LUMA SKIN</h3>
                    <p class="text-muted small mt-1">Admin Control</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger rounded-3 py-2 small text-center" role="alert">
                        <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
                    </div>
                }

                <form asp-controller="Admin" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">ชื่อผู้ใช้งาน (Username)</label>
                        <input type="text" class="form-control rounded-3 py-2.5" name="username" value="admin" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-secondary">รหัสผ่าน (Password)</label>
                        <input type="password" class="form-control rounded-3 py-2.5" name="password" value="12345" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-luma py-2.5 fw-bold shadow-sm">เข้าสู่ระบบ</button>
                    </div>
                </form>
            </div>
            
            <div class="text-center mt-3">
                <small class="text-muted">Luma Skin Inventory Management System</small>
            </div>
        </div>
    </div>
</div>